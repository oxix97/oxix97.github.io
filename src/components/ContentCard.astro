---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  description: string;
  publishedAt: Date;
  tags?: string[];
}

const { href, eyebrow, title, description, publishedAt, tags = [] } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'medium' }).format(publishedAt);
---

<article class="content-card">
  <div class="card-meta">
    <span>{eyebrow}</span>
    <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tag-list" aria-label="태그">
      {tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</article>
